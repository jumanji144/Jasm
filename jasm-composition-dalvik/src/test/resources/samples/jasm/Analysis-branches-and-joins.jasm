.super java/lang/Object
.class public AnalysisBranchesAndJoins {
    .method public static select (I)I {
        registers: 2,
        parameters: { condition },
        code: {
            if-eqz condition Alternate
            const v0 1
            goto Join
        Alternate:
            const v0 2
        Join:
            return v0
        }
    }
}
